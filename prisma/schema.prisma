  GOFOOD
  GRABFOOD
  SHOPEEFOOD
}

enum PaymentSettlementStatus {
  NOT_APPLICABLE
  PENDING
  SETTLED
}

enum SettlementBatchStatus {
  CONFIRMED
  REVERSED
