generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                              @id
  name                     String
  email                    String                              @unique
  emailVerified            Boolean                             @default(false)
  image                    String?
  role                     String?
  banned                   Boolean?                            @default(false)
  banReason                String?
  banExpires               DateTime?
  mustChangePassword       Boolean                             @default(false)
  createdAt                DateTime                            @default(now())
  updatedAt                DateTime                            @updatedAt
  jobPositionId            String?
  sessions                 Session[]
  accounts                 Account[]
  outletAssignments        UserOutletAssignment[]
  openedCashShifts         CashShift[]                         @relation("CashShiftOpenedBy")
  closedCashShifts         CashShift[]                         @relation("CashShiftClosedBy")
  cashMovements            CashMovement[]                      @relation("CashMovementActor")
  cashShiftCorrections     CashShiftReconciliationCorrection[] @relation("CashShiftCorrectionActor")
  cashShiftAuditLogs       CashShiftAuditLog[]                 @relation("CashShiftAuditActor")
  faceProfiles             FaceProfile[]
  faceReenrollmentRequests FaceReenrollmentRequest[]
  attendanceVerifications  AttendanceVerification[]
  attendanceAttempts       AttendanceAttempt[]
  attendanceSessions       AttendanceSession[]
  attendanceExceptions     AttendanceExceptionRequest[]
  attendanceCorrections    AttendanceCorrection[]              @relation("AttendanceCorrectionActor")
  jobPosition              StaffPosition?                      @relation(fields: [jobPositionId], references: [id], onDelete: Restrict)
  attendanceRosterEntries  AttendanceRosterEntry[]

  @@index([jobPositionId])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  activeOutletId String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOutlet   Outlet?  @relation(fields: [activeOutletId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeOutletId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum CatalogStatus {
  ACTIVE
  ARCHIVED
}

enum CatalogEntityType {
  CATEGORY
  PRODUCT
  VARIANT_GROUP
  VARIANT_OPTION
  MODIFIER_GROUP
  MODIFIER_OPTION
  PRODUCT_MODIFIER
  OUTLET_PRODUCT
  OUTLET_VARIANT_OPTION
}

enum CatalogAuditAction {
  CREATE
  UPDATE
  IMAGE_CHANGE
  PRICE_CHANGE
  AVAILABILITY_CHANGE
  ASSIGN
  UNASSIGN
  ARCHIVE
  RESTORE
  REORDER
}

model Category {
  id             String        @id @default(cuid())
  name           String
  normalizedName String        @unique
  description    String?       @db.VarChar(240)
  displayOrder   Int           @default(0)
  status         CatalogStatus @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  products       Product[]

  @@index([status, displayOrder])
  @@map("category")
}

model Product {
  id              String                  @id @default(cuid())
  categoryId      String
  name            String
  normalizedName  String
  sku             String?                 @unique
  description     String?                 @db.VarChar(280)
  imageUrl        String?                 @db.Text
  imagePositionX  Int                     @default(50)
  imagePositionY  Int                     @default(50)
  basePrice       Decimal                 @db.Decimal(12, 2)
  displayOrder    Int                     @default(0)
  status          CatalogStatus           @default(ACTIVE)
  archivedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  category        Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variantGroups   ProductVariantGroup[]
  modifierGroups  ProductModifierGroup[]
  outletOverrides OutletProductOverride[]
  channelPrices   ChannelProductPrice[]
  orderItems      OrderItem[]

  @@unique([categoryId, normalizedName])
  @@index([categoryId, status, displayOrder])
  @@index([status, updatedAt])
  @@map("product")
}

model ProductVariantGroup {
  id             String                 @id @default(cuid())
  productId      String
  name           String
  normalizedName String
  displayOrder   Int                    @default(0)
  status         CatalogStatus          @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  product        Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  options        ProductVariantOption[]

  @@unique([productId, normalizedName])
  @@index([productId, status, displayOrder])
  @@map("product_variant_group")
}

model ProductVariantOption {
  id              String                        @id @default(cuid())
  variantGroupId  String
  name            String
  normalizedName  String
  priceAdjustment Decimal                       @default(0) @db.Decimal(12, 2)
  displayOrder    Int                           @default(0)
  status          CatalogStatus                 @default(ACTIVE)
  archivedAt      DateTime?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  variantGroup    ProductVariantGroup           @relation(fields: [variantGroupId], references: [id], onDelete: Restrict)
  outletOverrides OutletVariantOptionOverride[]

  @@unique([variantGroupId, normalizedName])
  @@index([variantGroupId, status, displayOrder])
  @@map("product_variant_option")
}

model ModifierGroup {
  id             String                 @id @default(cuid())
  name           String
  normalizedName String                 @unique
  description    String?                @db.VarChar(240)
  status         CatalogStatus          @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  options        ModifierOption[]
  products       ProductModifierGroup[]

  @@index([status, name])
  @@map("modifier_group")
}

model ModifierOption {
  id              String        @id @default(cuid())
  modifierGroupId String
  name            String
  normalizedName  String
  priceAdjustment Decimal       @default(0) @db.Decimal(12, 2)
  displayOrder    Int           @default(0)
  status          CatalogStatus @default(ACTIVE)
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)

  @@unique([modifierGroupId, normalizedName])
  @@index([modifierGroupId, status, displayOrder])
  @@map("modifier_option")
}

model ProductModifierGroup {
  productId       String
  modifierGroupId String
  minSelections   Int           @default(0)
  maxSelections   Int           @default(1)
  displayOrder    Int           @default(0)
  status          CatalogStatus @default(ACTIVE)
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)

  @@id([productId, modifierGroupId])
  @@index([productId, status, displayOrder])
  @@index([modifierGroupId, status])
  @@map("product_modifier_group")
}

model OutletProductOverride {
  outletId      String
  productId     String
  isAvailable   Boolean  @default(true)
  priceOverride Decimal? @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  outlet        Outlet   @relation(fields: [outletId], references: [id], onDelete: Restrict)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([outletId, productId])
  @@index([productId, outletId])
  @@map("outlet_product_override")
}

model OutletVariantOptionOverride {
  outletId                String
  variantOptionId         String
  isAvailable             Boolean              @default(true)
  priceAdjustmentOverride Decimal?             @db.Decimal(12, 2)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  outlet                  Outlet               @relation(fields: [outletId], references: [id], onDelete: Restrict)
  variantOption           ProductVariantOption @relation(fields: [variantOptionId], references: [id], onDelete: Restrict)

  @@id([outletId, variantOptionId])
  @@index([variantOptionId, outletId])
  @@map("outlet_variant_option_override")
}

model CatalogAuditLog {
  id          String             @id @default(cuid())
  entityType  CatalogEntityType
  entityId    String
  action      CatalogAuditAction
  actorUserId String
  actorEmail  String
  before      Json?
  after       Json?
  createdAt   DateTime           @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("catalog_audit_log")
}

enum OutletStatus {
  ACTIVE
  ARCHIVED
}

enum ReceiptPaperSize {
  MM58
  MM80
}

enum AdminAuditEntityType {
  OUTLET
  STAFF
  STAFF_ASSIGNMENT
  SESSION
  DELIVERY_CHANNEL
  CHANNEL_PRODUCT_PRICE
  SETTLEMENT
  STAFF_POSITION
}

enum AdminAuditAction {
  CREATE
  UPDATE
  ARCHIVE
  RESTORE
  ASSIGN
  UNASSIGN
  DEACTIVATE
  REACTIVATE
  PASSWORD_RESET
  PASSWORD_CHANGE
  ACTIVE_OUTLET_CHANGE
}

enum AttendanceKind {
  CHECK_IN
  CHECK_OUT
}

enum AttendanceVerificationStatus {
  ACTIVE
  VERIFIED
  EXCEPTION_AVAILABLE
  EXPIRED
}

enum AttendanceAttemptResult {
  SUCCESS
  FAILED
}

enum AttendanceFailureReason {
  FACE_PROFILE_MISSING
  FACE_MISMATCH
  FACE_INVALID
  LIVENESS_FAILED
  CAMERA_UNAVAILABLE
  LOCATION_UNAVAILABLE
  LOCATION_INACCURATE
  LOCATION_OUTSIDE
  CHALLENGE_INVALID
  CONFIGURATION_MISSING
  ALREADY_CHECKED_IN
  SESSION_MISSING
  OUTLET_MISMATCH
}

enum AttendanceSessionStatus {
  OPEN
  CLOSED
}

enum AttendanceExceptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FaceReenrollmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceAuditAction {
  ENROLL
  REVOKE
  REENROLL_REQUEST
  REENROLL_APPROVE
  REENROLL_REJECT
  CHECK_IN
  CHECK_OUT
  EXCEPTION_REQUEST
  EXCEPTION_APPROVE
  EXCEPTION_REJECT
  CORRECT
  SETTINGS_UPDATE
  EVIDENCE_DELETE
  SHIFT_TEMPLATE_CREATE
  SHIFT_TEMPLATE_UPDATE
  SHIFT_TEMPLATE_ARCHIVE
  ROSTER_PUBLISH
  ROSTER_UPDATE
}

enum StaffPositionStatus {
  ACTIVE
  ARCHIVED
}

enum AttendanceRosterStatus {
  DRAFT
  PUBLISHED
}

enum AttendanceScheduleMatch {
  SCHEDULED
  UNSCHEDULED
}

model Outlet {
  id                               String                        @id @default(cuid())
  code                             String                        @unique
  name                             String
  normalizedName                   String                        @unique
  timezone                         String                        @default("Asia/Jakarta")
  addressLine                      String?                       @db.VarChar(240)
  provinceCode                     String
  provinceName                     String
  cityCode                         String
  cityName                         String
  taxRate                          Decimal                       @default(0) @db.Decimal(5, 2)
  serviceChargeRate                Decimal                       @default(0) @db.Decimal(5, 2)
  pricesIncludeTax                 Boolean                       @default(false)
  openOrdersEnabled                Boolean                       @default(false)
  receiptPaperSize                 ReceiptPaperSize              @default(MM80)
  receiptFooter                    String                        @default("Terima kasih atas kunjungan Anda.") @db.VarChar(160)
  attendanceEnabled                Boolean                       @default(false)
  attendanceLatitude               Decimal?                      @db.Decimal(9, 6)
  attendanceLongitude              Decimal?                      @db.Decimal(9, 6)
  attendanceRadiusMeters           Int                           @default(100)
  attendanceLateGraceMinutes       Int                           @default(15)
  attendanceEarlyLeaveGraceMinutes Int                           @default(15)
  status                           OutletStatus                  @default(ACTIVE)
  archivedAt                       DateTime?
  createdAt                        DateTime                      @default(now())
  updatedAt                        DateTime                      @updatedAt
  assignments                      UserOutletAssignment[]
  sessions                         Session[]
  productOverrides                 OutletProductOverride[]
  variantOptionOverrides           OutletVariantOptionOverride[]
  sales                            Sale[]
  receiptSequences                 ReceiptSequence[]
  deliveryChannels                 OutletDeliveryChannel[]
  cashShifts                       CashShift[]
  orders                           Order[]
  kitchenTickets                   KitchenTicket[]
  attendanceVerifications          AttendanceVerification[]
  attendanceAttempts               AttendanceAttempt[]
  attendanceSessions               AttendanceSession[]
  attendanceShiftTemplates         AttendanceShiftTemplate[]
  attendanceRosterWeeks            AttendanceRosterWeek[]
  attendanceRosterEntries          AttendanceRosterEntry[]

  @@index([status, name])
  @@map("outlet")
}

model FaceProfile {
  id                  String    @id @default(cuid())
  userId              String
  activeUserKey       String?   @unique
  embeddingCiphertext Bytes?
  embeddingIv         Bytes?
  embeddingLength     Int       @default(1024)
  modelVersion        String    @db.VarChar(80)
  consentAt           DateTime
  enrolledAt          DateTime  @default(now())
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, enrolledAt])
  @@map("face_profile")
}

model FaceReenrollmentRequest {
  id                  String                 @id @default(cuid())
  userId              String
  pendingUserKey      String?                @unique
  status              FaceReenrollmentStatus @default(PENDING)
  embeddingCiphertext Bytes?
  embeddingIv         Bytes?
  embeddingLength     Int                    @default(1024)
  modelVersion        String                 @db.VarChar(80)
  consentAt           DateTime
  requestedAt         DateTime               @default(now())
  reviewedByUserId    String?
  reviewedByName      String?
  reviewedByEmail     String?
  reviewReason        String?                @db.VarChar(240)
  reviewedAt          DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  user                User                   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@index([userId, requestedAt])
  @@map("face_reenrollment_request")
}

model AttendanceVerification {
  id              String                       @id @default(cuid())
  userId          String
  outletId        String
  kind            AttendanceKind
  status          AttendanceVerificationStatus @default(ACTIVE)
  nonceHash       String                       @unique @db.VarChar(64)
  challengeAction String                       @db.VarChar(24)
  attemptCount    Int                          @default(0)
  expiresAt       DateTime
  completedAt     DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  rosterEntryId   String?
  scheduleMatch   AttendanceScheduleMatch?
  user            User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  outlet          Outlet                       @relation(fields: [outletId], references: [id], onDelete: Restrict)
  attempts        AttendanceAttempt[]
  exception       AttendanceExceptionRequest?
  rosterEntry     AttendanceRosterEntry?       @relation(fields: [rosterEntryId], references: [id], onDelete: Restrict)

  @@index([userId, status, expiresAt])
  @@index([outletId, createdAt])
  @@index([rosterEntryId, createdAt])
  @@map("attendance_verification")
}

model AttendanceAttempt {
  id                String                       @id @default(cuid())
  verificationId    String
  userId            String
  outletId          String
  kind              AttendanceKind
  result            AttendanceAttemptResult
  failureReason     AttendanceFailureReason?
  similarity        Decimal?                     @db.Decimal(6, 5)
  livenessPassed    Boolean
  latitude          Decimal?                     @db.Decimal(9, 6)
  longitude         Decimal?                     @db.Decimal(9, 6)
  accuracyMeters    Decimal?                     @db.Decimal(8, 2)
  distanceMeters    Decimal?                     @db.Decimal(10, 2)
  evidencePath      String?                      @db.VarChar(500)
  evidenceExpiresAt DateTime?
  evidenceDeletedAt DateTime?
  attemptedAt       DateTime                     @default(now())
  idempotencyKey    String                       @unique @db.VarChar(80)
  verification      AttendanceVerification       @relation(fields: [verificationId], references: [id], onDelete: Restrict)
  user              User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  outlet            Outlet                       @relation(fields: [outletId], references: [id], onDelete: Restrict)
  checkInSession    AttendanceSession?           @relation("AttendanceCheckInAttempt")
  checkOutSession   AttendanceSession?           @relation("AttendanceCheckOutAttempt")
  exceptionRequests AttendanceExceptionRequest[]

  @@index([userId, attemptedAt])
  @@index([outletId, attemptedAt])
  @@index([evidenceExpiresAt, evidenceDeletedAt])
  @@map("attendance_attempt")
}

model AttendanceSession {
  id                String                  @id @default(cuid())
  userId            String
  outletId          String
  businessDate      DateTime                @db.Date
  status            AttendanceSessionStatus @default(OPEN)
  openUserKey       String?                 @unique
  checkInAt         DateTime
  checkInAttemptId  String                  @unique
  checkOutAt        DateTime?
  checkOutAttemptId String?                 @unique
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  rosterEntryId     String?                 @unique
  scheduleMatch     AttendanceScheduleMatch @default(UNSCHEDULED)
  user              User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  outlet            Outlet                  @relation(fields: [outletId], references: [id], onDelete: Restrict)
  checkInAttempt    AttendanceAttempt       @relation("AttendanceCheckInAttempt", fields: [checkInAttemptId], references: [id], onDelete: Restrict)
  checkOutAttempt   AttendanceAttempt?      @relation("AttendanceCheckOutAttempt", fields: [checkOutAttemptId], references: [id], onDelete: Restrict)
  corrections       AttendanceCorrection[]
  rosterEntry       AttendanceRosterEntry?  @relation(fields: [rosterEntryId], references: [id], onDelete: Restrict)

  @@index([userId, checkInAt])
  @@index([outletId, businessDate])
  @@map("attendance_session")
}

model StaffPosition {
  id             String                  @id @default(cuid())
  name           String                  @db.VarChar(80)
  normalizedName String                  @unique @db.VarChar(80)
  status         StaffPositionStatus     @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  users          User[]
  rosterEntries  AttendanceRosterEntry[]

  @@index([status, name])
  @@map("staff_position")
}

model AttendanceShiftTemplate {
  id             String                  @id @default(cuid())
  outletId       String
  name           String                  @db.VarChar(60)
  normalizedName String                  @db.VarChar(60)
  startMinute    Int
  endMinute      Int
  status         StaffPositionStatus     @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  outlet         Outlet                  @relation(fields: [outletId], references: [id], onDelete: Restrict)
  rosterEntries  AttendanceRosterEntry[]

  @@unique([outletId, normalizedName])
  @@index([outletId, status, name])
  @@map("attendance_shift_template")
}

model AttendanceRosterWeek {
  id                String                  @id @default(cuid())
  outletId          String
  weekStart         DateTime                @db.Date
  status            AttendanceRosterStatus  @default(DRAFT)
  publishedAt       DateTime?
  publishedByUserId String?
  publishedByName   String?
  publishedByEmail  String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  outlet            Outlet                  @relation(fields: [outletId], references: [id], onDelete: Restrict)
  entries           AttendanceRosterEntry[]

  @@unique([outletId, weekStart])
  @@index([status, weekStart])
  @@map("attendance_roster_week")
}

model AttendanceRosterEntry {
  id                     String                   @id @default(cuid())
  rosterWeekId           String
  shiftTemplateId        String
  userId                 String
  outletId               String
  positionId             String
  workDate               DateTime                 @db.Date
  scheduledStartAt       DateTime
  scheduledEndAt         DateTime
  timezone               String                   @db.VarChar(80)
  positionName           String                   @db.VarChar(80)
  shiftName              String                   @db.VarChar(60)
  lateGraceMinutes       Int                      @default(15)
  earlyLeaveGraceMinutes Int                      @default(15)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  rosterWeek             AttendanceRosterWeek     @relation(fields: [rosterWeekId], references: [id], onDelete: Cascade)
  shiftTemplate          AttendanceShiftTemplate  @relation(fields: [shiftTemplateId], references: [id], onDelete: Restrict)
  user                   User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  outlet                 Outlet                   @relation(fields: [outletId], references: [id], onDelete: Restrict)
  position               StaffPosition            @relation(fields: [positionId], references: [id], onDelete: Restrict)
  verifications          AttendanceVerification[]
  session                AttendanceSession?

  @@unique([userId, workDate])
  @@unique([rosterWeekId, userId, workDate])
  @@index([outletId, workDate])
  @@index([rosterWeekId, workDate])
  @@map("attendance_roster_entry")
}

model AttendanceExceptionRequest {
  id               String                    @id @default(cuid())
  verificationId   String                    @unique
  attemptId        String
  userId           String
  reason           String                    @db.VarChar(240)
  status           AttendanceExceptionStatus @default(PENDING)
  reviewedByUserId String?
  reviewedByName   String?
  reviewedByEmail  String?
  reviewReason     String?                   @db.VarChar(240)
  reviewedAt       DateTime?
  createdSessionId String?
  requestedAt      DateTime                  @default(now())
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  verification     AttendanceVerification    @relation(fields: [verificationId], references: [id], onDelete: Restrict)
  attempt          AttendanceAttempt         @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  user             User                      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@index([userId, requestedAt])
  @@map("attendance_exception_request")
}

model AttendanceCorrection {
  id                  String            @id @default(cuid())
  attendanceSessionId String
  correctedCheckInAt  DateTime?
  correctedCheckOutAt DateTime?
  reason              String            @db.VarChar(240)
  actorUserId         String
  actorName           String
  actorEmail          String
  createdAt           DateTime          @default(now())
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Restrict)
  actor               User              @relation("AttendanceCorrectionActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([attendanceSessionId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("attendance_correction")
}

model AttendanceAuditLog {
  id          String                @id @default(cuid())
  entityType  String                @db.VarChar(40)
  entityId    String
  action      AttendanceAuditAction
  actorUserId String
  actorEmail  String
  before      Json?
  after       Json?
  createdAt   DateTime              @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("attendance_audit_log")
}

