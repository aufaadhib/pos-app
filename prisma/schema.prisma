generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String                 @id
  name               String
  email              String                 @unique
  emailVerified      Boolean                @default(false)
  image              String?
  role               String?
  banned             Boolean?               @default(false)
  banReason          String?
  banExpires         DateTime?
  mustChangePassword Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  sessions           Session[]
  accounts           Account[]
  outletAssignments  UserOutletAssignment[]
  openedCashShifts   CashShift[]            @relation("CashShiftOpenedBy")
  closedCashShifts   CashShift[]            @relation("CashShiftClosedBy")
  cashMovements      CashMovement[]         @relation("CashMovementActor")
  cashShiftAuditLogs CashShiftAuditLog[]    @relation("CashShiftAuditActor")

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  activeOutletId String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOutlet   Outlet?  @relation(fields: [activeOutletId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeOutletId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum CatalogStatus {
  ACTIVE
  ARCHIVED
}

enum CatalogEntityType {
  CATEGORY
  PRODUCT
  VARIANT_GROUP
  VARIANT_OPTION
  MODIFIER_GROUP
  MODIFIER_OPTION
  PRODUCT_MODIFIER
  OUTLET_PRODUCT
  OUTLET_VARIANT_OPTION
}

enum CatalogAuditAction {
  CREATE
  UPDATE
  IMAGE_CHANGE
  PRICE_CHANGE
  AVAILABILITY_CHANGE
  ASSIGN
  UNASSIGN
  ARCHIVE
  RESTORE
  REORDER
}

model Category {
  id             String        @id @default(cuid())
  name           String
  normalizedName String        @unique
  description    String?       @db.VarChar(240)
  displayOrder   Int           @default(0)
  status         CatalogStatus @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  products       Product[]

  @@index([status, displayOrder])
  @@map("category")
}

model Product {
  id              String                  @id @default(cuid())
  categoryId      String
  name            String
  normalizedName  String
  sku             String?                 @unique
  description     String?                 @db.VarChar(280)
  imageUrl        String?                 @db.Text
  imagePositionX  Int                     @default(50)
  imagePositionY  Int                     @default(50)
  basePrice       Decimal                 @db.Decimal(12, 2)
  displayOrder    Int                     @default(0)
  status          CatalogStatus           @default(ACTIVE)
  archivedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  category        Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variantGroups   ProductVariantGroup[]
  modifierGroups  ProductModifierGroup[]
  outletOverrides OutletProductOverride[]
  channelPrices   ChannelProductPrice[]
  orderItems      OrderItem[]

  @@unique([categoryId, normalizedName])
  @@index([categoryId, status, displayOrder])
  @@index([status, updatedAt])
  @@map("product")
}

model ProductVariantGroup {
  id             String                 @id @default(cuid())
  productId      String
  name           String
  normalizedName String
  displayOrder   Int                    @default(0)
  status         CatalogStatus          @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  product        Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  options        ProductVariantOption[]

  @@unique([productId, normalizedName])
  @@index([productId, status, displayOrder])
  @@map("product_variant_group")
}

model ProductVariantOption {
  id              String                        @id @default(cuid())
  variantGroupId  String
  name            String
  normalizedName  String
  priceAdjustment Decimal                       @default(0) @db.Decimal(12, 2)
  displayOrder    Int                           @default(0)
  status          CatalogStatus                 @default(ACTIVE)
  archivedAt      DateTime?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  variantGroup    ProductVariantGroup           @relation(fields: [variantGroupId], references: [id], onDelete: Restrict)
  outletOverrides OutletVariantOptionOverride[]

  @@unique([variantGroupId, normalizedName])
  @@index([variantGroupId, status, displayOrder])
  @@map("product_variant_option")
}

model ModifierGroup {
  id             String                 @id @default(cuid())
  name           String
  normalizedName String                 @unique
  description    String?                @db.VarChar(240)
  status         CatalogStatus          @default(ACTIVE)
  archivedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  options        ModifierOption[]
  products       ProductModifierGroup[]

  @@index([status, name])
  @@map("modifier_group")
}

model ModifierOption {
  id              String        @id @default(cuid())
  modifierGroupId String
  name            String
  normalizedName  String
  priceAdjustment Decimal       @default(0) @db.Decimal(12, 2)
  displayOrder    Int           @default(0)
  status          CatalogStatus @default(ACTIVE)
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)

  @@unique([modifierGroupId, normalizedName])
  @@index([modifierGroupId, status, displayOrder])
  @@map("modifier_option")
}

model ProductModifierGroup {
  productId       String
  modifierGroupId String
  minSelections   Int           @default(0)
  maxSelections   Int           @default(1)
  displayOrder    Int           @default(0)
  status          CatalogStatus @default(ACTIVE)
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)

  @@id([productId, modifierGroupId])
  @@index([productId, status, displayOrder])
  @@index([modifierGroupId, status])
  @@map("product_modifier_group")
}

model OutletProductOverride {
  outletId      String
  productId     String
  isAvailable   Boolean  @default(true)
  priceOverride Decimal? @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  outlet        Outlet   @relation(fields: [outletId], references: [id], onDelete: Restrict)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([outletId, productId])
  @@index([productId, outletId])
  @@map("outlet_product_override")
}

model OutletVariantOptionOverride {
  outletId                String
  variantOptionId         String
  isAvailable             Boolean              @default(true)
  priceAdjustmentOverride Decimal?             @db.Decimal(12, 2)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  outlet                  Outlet               @relation(fields: [outletId], references: [id], onDelete: Restrict)
  variantOption           ProductVariantOption @relation(fields: [variantOptionId], references: [id], onDelete: Restrict)

  @@id([outletId, variantOptionId])
  @@index([variantOptionId, outletId])
  @@map("outlet_variant_option_override")
}

model CatalogAuditLog {
  id          String             @id @default(cuid())
  entityType  CatalogEntityType
  entityId    String
  action      CatalogAuditAction
  actorUserId String
  actorEmail  String
  before      Json?
  after       Json?
  createdAt   DateTime           @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("catalog_audit_log")
}

enum OutletStatus {
  ACTIVE
  ARCHIVED
}

enum ReceiptPaperSize {
  MM58
  MM80
}

enum AdminAuditEntityType {
  OUTLET
  STAFF
  STAFF_ASSIGNMENT
  SESSION
  DELIVERY_CHANNEL
  CHANNEL_PRODUCT_PRICE
  SETTLEMENT
}

enum AdminAuditAction {
  CREATE
  UPDATE
  ARCHIVE
  RESTORE
  ASSIGN
  UNASSIGN
  DEACTIVATE
  REACTIVATE
  PASSWORD_RESET
  PASSWORD_CHANGE
  ACTIVE_OUTLET_CHANGE
}

model Outlet {
  id                     String                        @id @default(cuid())
  code                   String                        @unique
  name                   String
  normalizedName         String                        @unique
  timezone               String                        @default("Asia/Jakarta")
  addressLine            String?                       @db.VarChar(240)
  provinceCode           String
  provinceName           String
  cityCode               String
  cityName               String
  taxRate                Decimal                       @default(0) @db.Decimal(5, 2)
  serviceChargeRate      Decimal                       @default(0) @db.Decimal(5, 2)
  pricesIncludeTax       Boolean                       @default(false)
  openOrdersEnabled      Boolean                       @default(false)
  receiptPaperSize       ReceiptPaperSize              @default(MM80)
  receiptFooter          String                        @default("Terima kasih atas kunjungan Anda.") @db.VarChar(160)
  status                 OutletStatus                  @default(ACTIVE)
  archivedAt             DateTime?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  assignments            UserOutletAssignment[]
  sessions               Session[]
  productOverrides       OutletProductOverride[]
  variantOptionOverrides OutletVariantOptionOverride[]
  sales                  Sale[]
  receiptSequences       ReceiptSequence[]
  deliveryChannels       OutletDeliveryChannel[]
  cashShifts             CashShift[]
  orders                 Order[]
  kitchenTickets         KitchenTicket[]

  @@index([status, name])
  @@map("outlet")
}

enum SaleOrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum PaymentMethod {
  CASH
  QRIS
  DEBIT_CARD
  CREDIT_CARD
  BANK_TRANSFER
  DELIVERY_PLATFORM
}

enum DeliveryProvider {
  GOFOOD
  GRABFOOD
  SHOPEEFOOD
}

enum PaymentSettlementStatus {
  NOT_APPLICABLE
  PENDING
  SETTLED
}

enum SettlementBatchStatus {
  CONFIRMED
  REVERSED
}

enum SaleAuditAction {
  CREATE
  SETTLE
  UNSETTLE
  VOID
  REFUND
}

enum SaleStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum OrderStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum OrderAuditAction {
  CREATE
  UPDATE
  SEND
  PRICE_REFRESH
  COMPLETE
  CANCEL
}

enum KitchenTicketKind {
  INITIAL
  DELTA
}

enum KitchenTicketStatus {
  NEW
  PROCESSING
  COMPLETED
}

enum KitchenTicketLineAction {
  ADD
  UPDATE
  REMOVE
}

enum SaleRefundType {
  VOID
  REFUND
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

enum CashShiftCloseMode {
  SELF
  FORCED
}

enum CashMovementDirection {
  IN
  OUT
}

enum CashMovementCategory {
  ADDITIONAL_FLOAT
  CASH_DROP
  OPERATING_EXPENSE
  OTHER
}

enum CashShiftAuditAction {
  OPEN
  CASH_IN
  CASH_OUT
  CLOSE
  FORCE_CLOSE
}

model OutletDeliveryChannel {
  id                   String                @id @default(cuid())
  outletId             String
  provider             DeliveryProvider
  isActive             Boolean               @default(false)
  markupRate           Decimal               @default(0) @db.Decimal(5, 2)
  estimatedFeeRate     Decimal               @default(0) @db.Decimal(5, 2)
  roundingUnit         Int                   @default(500)
  settlementDelayHours Int                   @default(24)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  outlet               Outlet                @relation(fields: [outletId], references: [id], onDelete: Restrict)
  productPrices        ChannelProductPrice[]
  sales                Sale[]
  orders               Order[]
  settlements          PlatformSettlement[]

  @@unique([outletId, provider])
  @@index([outletId, isActive])
  @@map("outlet_delivery_channel")
}

model ChannelProductPrice {
  channelId     String
  productId     String
  priceOverride Decimal               @db.Decimal(12, 2)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  channel       OutletDeliveryChannel @relation(fields: [channelId], references: [id], onDelete: Restrict)
  product       Product               @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([channelId, productId])
  @@index([productId, channelId])
  @@map("channel_product_price")
}

model ReceiptSequence {
  outletId     String
  businessDate DateTime @db.Date
  lastValue    Int      @default(0)
  updatedAt    DateTime @updatedAt
  outlet       Outlet   @relation(fields: [outletId], references: [id], onDelete: Restrict)

  @@id([outletId, businessDate])
  @@map("receipt_sequence")
}

model Sale {
  id                  String                 @id @default(cuid())
  checkoutToken       String                 @unique
  outletId            String
  shiftId             String?
  orderId             String?                @unique
  receiptNumber       String
  businessDate        DateTime               @db.Date
  dailySequence       Int
  orderType           SaleOrderType
  tableLabel          String?                @db.VarChar(40)
  channelId           String?
  externalOrderId     String?                @db.VarChar(80)
  status              SaleStatus             @default(COMPLETED)
  subtotal            Decimal                @db.Decimal(14, 2)
  serviceChargeRate   Decimal                @db.Decimal(5, 2)
  serviceChargeAmount Decimal                @db.Decimal(14, 2)
  taxRate             Decimal                @db.Decimal(5, 2)
  taxAmount           Decimal                @db.Decimal(14, 2)
  pricesIncludeTax    Boolean
  total               Decimal                @db.Decimal(14, 2)
  createdByUserId     String
  createdByName       String
  createdByEmail      String
  completedAt         DateTime               @default(now())
  createdAt           DateTime               @default(now())
  outlet              Outlet                 @relation(fields: [outletId], references: [id], onDelete: Restrict)
  shift               CashShift?             @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  order               Order?                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  channel             OutletDeliveryChannel? @relation(fields: [channelId], references: [id], onDelete: Restrict)
  items               SaleItem[]
  payment             SalePayment?
  auditLogs           SaleAuditLog[]
  refunds             SaleRefund[]

  @@unique([outletId, receiptNumber])
  @@unique([outletId, businessDate, dailySequence])
  @@unique([channelId, externalOrderId])
  @@index([outletId, status, completedAt])
  @@index([shiftId, completedAt])
  @@index([createdByUserId, completedAt])
  @@index([channelId, completedAt])
  @@map("sale")
}

model CashShift {
  id             String              @id @default(cuid())
  outletId       String
  businessDate   DateTime            @db.Date
  status         CashShiftStatus     @default(OPEN)
  openUserKey    String?             @unique
  openToken      String              @unique
  openingCash    Decimal             @db.Decimal(14, 2)
  openedByUserId String
  openedByName   String
  openedByEmail  String
  openedAt       DateTime            @default(now())
  closeMode      CashShiftCloseMode?
  closeToken     String?             @unique
  closedByUserId String?
  closedByName   String?
  closedByEmail  String?
  expectedCash   Decimal?            @db.Decimal(14, 2)
  actualCash     Decimal?            @db.Decimal(14, 2)
  cashDifference Decimal?            @db.Decimal(14, 2)
  closeReason    String?             @db.VarChar(240)
  closedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  outlet         Outlet              @relation(fields: [outletId], references: [id], onDelete: Restrict)
  openedBy       User                @relation("CashShiftOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  closedBy       User?               @relation("CashShiftClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  sales          Sale[]
  movements      CashMovement[]
  auditLogs      CashShiftAuditLog[]
  refunds        SaleRefund[]
  openedOrders   Order[]             @relation("OrderOpenedShift")

  @@index([outletId, status, openedAt])
  @@index([openedByUserId, openedAt])
  @@map("cash_shift")
}

model Order {
  id                   String                 @id @default(cuid())
  operationToken       String                 @unique
  lastOperationToken   String?                @unique
  outletId             String
  openedShiftId        String?
  orderType            SaleOrderType
  tableLabel           String?                @db.VarChar(40)
  normalizedTableLabel String?                @db.VarChar(40)
  activeTableKey       String?                @unique @db.VarChar(100)
  channelId            String?
  externalOrderId      String?                @db.VarChar(80)
  status               OrderStatus            @default(OPEN)
  version              Int                    @default(1)
  lastSentVersion      Int                    @default(0)
  subtotal             Decimal                @db.Decimal(14, 2)
  serviceChargeRate    Decimal                @db.Decimal(5, 2)
  serviceChargeAmount  Decimal                @db.Decimal(14, 2)
  taxRate              Decimal                @db.Decimal(5, 2)
  taxAmount            Decimal                @db.Decimal(14, 2)
  pricesIncludeTax     Boolean
  total                Decimal                @db.Decimal(14, 2)
  createdByUserId      String
  createdByName        String
  createdByEmail       String
  completedAt          DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?                @db.VarChar(240)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  outlet               Outlet                 @relation(fields: [outletId], references: [id], onDelete: Restrict)
  openedShift          CashShift?             @relation("OrderOpenedShift", fields: [openedShiftId], references: [id], onDelete: Restrict)
  channel              OutletDeliveryChannel? @relation(fields: [channelId], references: [id], onDelete: Restrict)
  sale                 Sale?
  items                OrderItem[]
  kitchenTickets       KitchenTicket[]
  auditLogs            OrderAuditLog[]

  @@unique([channelId, externalOrderId])
  @@index([outletId, status, updatedAt])
  @@index([openedShiftId, createdAt])
  @@map("pos_order")
}

model OrderItem {
  id                 String              @id @default(cuid())
  orderId            String
  productId          String
  productName        String
  sku                String?
  quantity           Int
  note               String?             @db.VarChar(240)
  variantOptionIds   String[]
  modifierOptionIds  String[]
  selectionLabel     String?             @db.VarChar(280)
  unitPrice          Decimal             @db.Decimal(14, 2)
  sentQuantity       Int                 @default(0)
  sentNote           String?             @db.VarChar(240)
  sentSelectionLabel String?             @db.VarChar(280)
  changeReason       String?             @db.VarChar(240)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  kitchenTicketLines KitchenTicketLine[]

  @@index([orderId, createdAt])
  @@index([productId])
  @@map("order_item")
}

model KitchenTicket {
  id                    String              @id @default(cuid())
  number                BigInt              @unique @default(autoincrement())
  operationToken        String              @unique
  outletId              String
  orderId               String
  orderVersion          Int
  kind                  KitchenTicketKind
  status                KitchenTicketStatus @default(NEW)
  sentByUserId          String
  sentByName            String
  sentAt                DateTime            @default(now())
  statusUpdatedByUserId String?
  statusUpdatedByName   String?
  statusUpdatedAt       DateTime?
  completedAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  outlet                Outlet              @relation(fields: [outletId], references: [id], onDelete: Restrict)
  order                 Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lines                 KitchenTicketLine[]

  @@unique([orderId, orderVersion])
  @@index([outletId, status, sentAt])
  @@index([orderId, sentAt])
  @@map("kitchen_ticket")
}

model KitchenTicketLine {
  id             String                  @id @default(cuid())
  ticketId       String
  orderItemId    String?
  action         KitchenTicketLineAction
  productName    String
  quantity       Int
  selectionLabel String?                 @db.VarChar(280)
  note           String?                 @db.VarChar(240)
  reason         String?                 @db.VarChar(240)
  ticket         KitchenTicket           @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  orderItem      OrderItem?              @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([orderItemId])
  @@map("kitchen_ticket_line")
}

model OrderAuditLog {
  id          String           @id @default(cuid())
  orderId     String
  action      OrderAuditAction
  actorUserId String
  actorEmail  String
  before      Json?
  after       Json?
  createdAt   DateTime         @default(now())
  order       Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("order_audit_log")
}

model CashMovement {
  id             String                @id @default(cuid())
  shiftId        String
  operationToken String                @unique
  direction      CashMovementDirection
  category       CashMovementCategory
  amount         Decimal               @db.Decimal(14, 2)
  reason         String                @db.VarChar(240)
  actorUserId    String
  actorName      String
  actorEmail     String
  createdAt      DateTime              @default(now())
  shift          CashShift             @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  actor          User                  @relation("CashMovementActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([shiftId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("cash_movement")
}

model CashShiftAuditLog {
  id          String               @id @default(cuid())
  shiftId     String
  action      CashShiftAuditAction
  actorUserId String
  actorEmail  String
  after       Json
  createdAt   DateTime             @default(now())
  shift       CashShift            @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  actor       User                 @relation("CashShiftAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([shiftId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("cash_shift_audit_log")
}

model SaleItem {
  id                 String             @id @default(cuid())
  saleId             String
  productId          String
  productName        String
  categoryId         String?
  categoryName       String?
  sku                String?
  quantity           Int
  note               String?            @db.VarChar(240)
  baseUnitPrice      Decimal            @db.Decimal(14, 2)
  variantUnitAmount  Decimal            @db.Decimal(14, 2)
  modifierUnitAmount Decimal            @db.Decimal(14, 2)
  unitPrice          Decimal            @db.Decimal(14, 2)
  lineTotal          Decimal            @db.Decimal(14, 2)
  directUnitPrice    Decimal            @db.Decimal(14, 2)
  sale               Sale               @relation(fields: [saleId], references: [id], onDelete: Restrict)
  variants           SaleItemVariant[]
  modifiers          SaleItemModifier[]
  refundItems        SaleRefundItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_item")
}

model SaleItemVariant {
  id               String   @id @default(cuid())
  saleItemId       String
  variantGroupId   String
  variantGroupName String
  optionId         String
  optionName       String
  priceAdjustment  Decimal  @db.Decimal(14, 2)
  saleItem         SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Restrict)

  @@index([saleItemId])
  @@map("sale_item_variant")
}

model SaleItemModifier {
  id                String   @id @default(cuid())
  saleItemId        String
  modifierGroupId   String
  modifierGroupName String
  optionId          String
  optionName        String
  priceAdjustment   Decimal  @db.Decimal(14, 2)
  saleItem          SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Restrict)

  @@index([saleItemId])
  @@map("sale_item_modifier")
}

model SalePayment {
  id                     String                   @id @default(cuid())
  saleId                 String                   @unique
  method                 PaymentMethod
  amount                 Decimal                  @db.Decimal(14, 2)
  reference              String?                  @db.VarChar(80)
  tenderedAmount         Decimal?                 @db.Decimal(14, 2)
  changeAmount           Decimal?                 @db.Decimal(14, 2)
  settlementStatus       PaymentSettlementStatus  @default(NOT_APPLICABLE)
  expectedFeeRate        Decimal?                 @db.Decimal(5, 2)
  expectedFeeAmount      Decimal?                 @db.Decimal(14, 2)
  expectedNetAmount      Decimal?                 @db.Decimal(14, 2)
  directEquivalentAmount Decimal?                 @db.Decimal(14, 2)
  expectedSettlementAt   DateTime?
  createdAt              DateTime                 @default(now())
  sale                   Sale                     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  settlementItems        PlatformSettlementItem[]

  @@index([method, createdAt])
  @@index([settlementStatus, expectedSettlementAt])
  @@map("sale_payment")
}

model SaleRefund {
  id                     String           @id @default(cuid())
  saleId                 String
  cashShiftId            String?
  operationToken         String           @unique
  type                   SaleRefundType
  method                 PaymentMethod
  subtotalAmount         Decimal          @db.Decimal(14, 2)
  serviceChargeAmount    Decimal          @db.Decimal(14, 2)
  taxAmount              Decimal          @db.Decimal(14, 2)
  amount                 Decimal          @db.Decimal(14, 2)
  expectedFeeAmount      Decimal?         @db.Decimal(14, 2)
  expectedNetAmount      Decimal?         @db.Decimal(14, 2)
  directEquivalentAmount Decimal?         @db.Decimal(14, 2)
  reason                 String           @db.VarChar(240)
  providerReference      String?          @db.VarChar(80)
  actorUserId            String
  actorName              String
  actorEmail             String
  createdAt              DateTime         @default(now())
  sale                   Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  cashShift              CashShift?       @relation(fields: [cashShiftId], references: [id], onDelete: Restrict)
  items                  SaleRefundItem[]

  @@index([saleId, createdAt])
  @@index([cashShiftId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("sale_refund")
}

model SaleRefundItem {
  id         String     @id @default(cuid())
  refundId   String
  saleItemId String
  quantity   Int
  lineAmount Decimal    @db.Decimal(14, 2)
  refund     SaleRefund @relation(fields: [refundId], references: [id], onDelete: Restrict)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Restrict)

  @@unique([refundId, saleItemId])
  @@index([saleItemId])
  @@map("sale_refund_item")
}

model PlatformSettlement {
  id                      String                   @id @default(cuid())
  channelId               String
  reference               String                   @db.VarChar(80)
  grossAmount             Decimal                  @db.Decimal(14, 2)
  platformFeeAmount       Decimal                  @db.Decimal(14, 2)
  merchantPromotionAmount Decimal                  @db.Decimal(14, 2)
  otherAdjustmentAmount   Decimal                  @db.Decimal(14, 2)
  otherAdjustmentNote     String?                  @db.VarChar(240)
  netReceivedAmount       Decimal                  @db.Decimal(14, 2)
  receivedAt              DateTime
  status                  SettlementBatchStatus    @default(CONFIRMED)
  confirmedByUserId       String
  confirmedByName         String
  confirmedByEmail        String
  reversedAt              DateTime?
  reversedByUserId        String?
  reversedByEmail         String?
  reversalReason          String?                  @db.VarChar(240)
  createdAt               DateTime                 @default(now())
  channel                 OutletDeliveryChannel    @relation(fields: [channelId], references: [id], onDelete: Restrict)
  items                   PlatformSettlementItem[]

  @@unique([channelId, reference])
  @@index([channelId, receivedAt])
  @@index([status, receivedAt])
  @@map("platform_settlement")
}

model PlatformSettlementItem {
  settlementId           String
  salePaymentId          String
  grossAmount            Decimal            @db.Decimal(14, 2)
  directEquivalentAmount Decimal            @db.Decimal(14, 2)
  expectedNetAmount      Decimal            @db.Decimal(14, 2)
  settlement             PlatformSettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  salePayment            SalePayment        @relation(fields: [salePaymentId], references: [id], onDelete: Restrict)

  @@id([settlementId, salePaymentId])
  @@index([salePaymentId])
  @@map("platform_settlement_item")
}

model SaleAuditLog {
  id          String          @id @default(cuid())
  saleId      String
  action      SaleAuditAction
  actorUserId String
  actorEmail  String
  after       Json
  createdAt   DateTime        @default(now())
  sale        Sale            @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([saleId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("sale_audit_log")
}

model UserOutletAssignment {
  userId           String
  outletId         String
  assignedByUserId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet           Outlet   @relation(fields: [outletId], references: [id], onDelete: Restrict)

  @@id([userId, outletId])
  @@index([outletId, userId])
  @@map("user_outlet_assignment")
}

model AdminAuditLog {
  id          String               @id @default(cuid())
  entityType  AdminAuditEntityType
  entityId    String
  action      AdminAuditAction
  actorUserId String
  actorEmail  String
  before      Json?
  after       Json?
  createdAt   DateTime             @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("admin_audit_log")
}
