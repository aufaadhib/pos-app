# Neon pooled connection (runtime)
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require"

# Neon direct connection (Prisma migrations)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"

# Vercel Blob public store (required only when uploading or removing product images)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_replace-me"

# Absensi only: private evidence store, 32-byte AES key encoded as base64, and Vercel Cron bearer token.
ATTENDANCE_BLOB_READ_WRITE_TOKEN="vercel_blob_rw_replace-me"
ATTENDANCE_EMBEDDING_KEY="replace-with-base64-encoded-32-byte-key"
CRON_SECRET="replace-with-a-long-random-value"

# Bootstrap only. Remove INITIAL_OWNER_PASSWORD after `npm run seed:owner` succeeds.
INITIAL_OWNER_NAME="Pemilik Glutong"
INITIAL_OWNER_EMAIL="owner@example.com"
INITIAL_OWNER_PASSWORD="replace-with-at-least-12-characters"

# Hanya aktifkan pada branch database development/test.
E2E_ALLOW_TEST_USERS="false"
