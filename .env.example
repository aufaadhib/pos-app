# Neon pooled connection (runtime)
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require"

# Neon direct connection (Prisma migrations)
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"

# Bootstrap only. Remove INITIAL_OWNER_PASSWORD after `npm run seed:owner` succeeds.
INITIAL_OWNER_NAME="Pemilik Glutong"
INITIAL_OWNER_EMAIL="owner@example.com"
INITIAL_OWNER_PASSWORD="replace-with-at-least-12-characters"
